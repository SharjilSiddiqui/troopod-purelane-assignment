{% liquid
  assign card_product = product
  assign card_class = card_class | default: ''
  assign show_rating = show_rating | default: true
  assign show_badge = show_badge | default: true
  assign button_label = button_label | default: 'Add to cart'
%}

<article class="pl-card {{ card_class }}">
  <div class="pl-card__media">
    {% if show_badge and card_product.available == false %}
      <span class="pl-card__pill pl-card__pill--sold">Sold out</span>
    {% elsif show_badge and card_product.compare_at_price > card_product.price %}
      <span class="pl-card__pill">Sale</span>
    {% endif %}

    <a
      href="{{ card_product.url }}"
      class="pl-card__image-link"
      aria-label="{{ card_product.title | escape }}"
    >
      {% if card_product.featured_image %}
        {{
          card_product.featured_image
          | image_url: width: 700
          | image_tag:
            class: 'pl-card__image',
            loading: 'lazy',
            widths: '240, 360, 480, 600, 700',
            sizes: '(min-width: 860px) 25vw, 50vw',
            alt: card_product.featured_image.alt | default: card_product.title
        }}
      {% else %}
        <div class="pl-card__placeholder" aria-hidden="true">
          <span>Purelane</span>
          <small>No image</small>
        </div>
      {% endif %}
    </a>
  </div>

  <div class="pl-card__content">
    <h3 class="pl-card__title">
      <a href="{{ card_product.url }}">
        {{ card_product.title }}
      </a>
    </h3>

    {% if show_rating %}
      <div class="pl-card__rating" aria-label="Product rating">
        <span aria-hidden="true">★</span>
        <span>{{ card_product.metafields.reviews.rating.value | default: '4.8' }}</span>
        {% if card_product.metafields.reviews.review_count.value %}
          <span aria-hidden="true">·</span>
          <span>{{ card_product.metafields.reviews.review_count.value }} reviews</span>
        {% endif %}
      </div>
    {% endif %}

    <div class="pl-card__price">
      <strong>{{ card_product.price | money }}</strong>

      {% if card_product.compare_at_price > card_product.price %}
        <s>{{ card_product.compare_at_price | money }}</s>

        {% assign savings = card_product.compare_at_price | minus: card_product.price %}
        {% assign savings_percent = savings | times: 100.0 | divided_by: card_product.compare_at_price | round %}

        <em>{{ savings_percent }}% off</em>
      {% endif %}
    </div>

    {% if card_product.available %}
      <form method="post" action="{{ routes.cart_add_url }}" class="pl-card__form">
        <input
          type="hidden"
          name="id"
          value="{{ card_product.selected_or_first_available_variant.id }}"
        >

        <input type="hidden" name="quantity" value="1">

        <button
          type="submit"
          class="pl-button pl-button--ghost pl-button--small"
          {% unless card_product.selected_or_first_available_variant.available %}
            disabled
          {% endunless %}
        >
          {{ button_label }}
        </button>
      </form>
    {% else %}
      <button
        type="button"
        class="pl-button pl-button--ghost pl-button--small"
        disabled
      >
        Sold out
      </button>
    {% endif %}
  </div>
</article>