<section
  id="shop"
  class="purelane-section pl-shop"
>
  <div class="purelane-wrap">

    <header class="pl-section-head">
      <span class="pl-kicker">
        {{ section.settings.kicker | escape }}
      </span>

      <h2 class="pl-heading pl-heading--section">
        {{ section.settings.heading | escape }}
      </h2>

      <div class="pl-rule" aria-hidden="true">
        <i></i>
        {% render 'purelane-leaf-icon' %}
        <i></i>
      </div>
    </header>

    {% assign selected_collection = section.settings.collection %}

    {% if selected_collection != blank %}
      <div class="pl-shop__grid">
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          {% render 'purelane-product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <div class="pl-glass" style="padding: 40px; text-align:center;">
        <p>
          Select a collection in the theme editor.
        </p>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Purelane shop",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane shop"
    }
  ]
}
{% endschema %}