{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section
  id="purelane-hero-{{ section.id }}"
  class="purelane-section pl-hero"
>
  <div class="pl-hero__inner">

    <aside class="pl-hero__badges pl-glass" aria-label="Product promises">
      <div class="pl-hero__badge">
        <span class="pl-hero__badge-icon">
          {% render 'purelane-leaf-icon' %}
        </span>
        <span>Plant<br>powered</span>
      </div>

      <div class="pl-hero__badge">
        <span class="pl-hero__badge-icon">
          {% render 'purelane-safe-icon' %}
        </span>
        <span>Safe for<br>kids & pets</span>
      </div>

      <div class="pl-hero__badge">
        <span class="pl-hero__badge-icon">
          {% render 'purelane-clean-icon' %}
        </span>
        <span>Zero harsh<br>chemicals</span>
      </div>
    </aside>

    <div class="pl-hero__copy">

      <h1 class="pl-heading pl-heading--hero pl-hero__heading">
        {{ section.settings.heading_line_1 | escape }}<br>
        {{ section.settings.heading_line_2 | escape }}<br>
        <span class="accent">
          {{ section.settings.heading_accent | escape }}
        </span>
      </h1>

      <div class="pl-rule" aria-hidden="true">
        <i></i>
        {% render 'purelane-leaf-icon' %}
        <i></i>
      </div>

      {% if section.settings.description != blank %}
        <p class="pl-lede">
          {{ section.settings.description }}
        </p>
      {% endif %}

      <div class="pl-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a
            class="pl-button pl-button--primary"
            href="{{ section.settings.primary_link | default: '#shop' }}"
          >
            {{ section.settings.primary_label | escape }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a
            class="pl-button pl-button--ghost"
            href="{{ section.settings.secondary_link | default: '#combos' }}"
          >
            {{ section.settings.secondary_label | escape }}
          </a>
        {% endif %}
      </div>

      <div class="pl-hero__mobile-badges">
        <div class="pl-glass pl-hero__mobile-badge">
          {% render 'purelane-leaf-icon' %}
          Plant powered
        </div>

        <div class="pl-glass pl-hero__mobile-badge">
          {% render 'purelane-safe-icon' %}
          Kids & pet safe
        </div>

        <div class="pl-glass pl-hero__mobile-badge">
          {% render 'purelane-clean-icon' %}
          Zero harsh chem
        </div>
      </div>
    </div>

    <div class="pl-hero__products">
      <div class="pl-hero__stage" data-purelane-hero-stage>

        {% for block in section.blocks limit: 3 %}

          <div
            class="pl-hero__slide{% if forloop.first %} is-active{% endif %}"
            data-purelane-hero-slide
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >

            {% for product in block.settings.products limit: 3 %}

  {% if product.featured_image %}
    {{
      product.featured_image
      | image_url: width: 900
      | image_tag:
        class: 'pl-hero__product',
        loading: 'eager',
        widths: '400,600,800,900',
        sizes: '(min-width: 901px) 45vw, 90vw',
        alt: product.title
    }}
  {% endif %}
{% endfor %}

<style>
  #purelane-hero-{{ section.id }}
  [data-index="{{ forloop.index0 }}"]
  .pl-hero__product:nth-of-type(1) {
    height: 100%;
    z-index: 3;
  }
</style>

            {% if block.settings.products.size > 0 %}

              <div class="pl-glass pl-hero__price">
                <span class="pl-hero__price-label">
                  {{ block.settings.label | default: 'Special offer' | escape }}
                </span>

                <span class="pl-hero__price-row">
                  <strong>
                    {{ block.settings.offer_price | money }}
                  </strong>

                  {% if block.settings.compare_price > block.settings.offer_price %}
                    <s>{{ block.settings.compare_price | money }}</s>
                  {% endif %}
                </span>

                {% if block.settings.saving_text != blank %}
                  <span class="pl-hero__saving">
                    {{ block.settings.saving_text | escape }}
                  </span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}

      </div>

      <div
        class="pl-hero__dots"
        role="tablist"
        aria-label="Hero offers"
      >
        {% for block in section.blocks limit: 3 %}
          <button
            type="button"
            class="pl-hero__dot{% if forloop.first %} is-active{% endif %}"
            data-purelane-hero-dot
            data-index="{{ forloop.index0 }}"
            role="tab"
            aria-label="Show offer {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('purelane-hero-{{ section.id }}');
  if (!root || root.dataset.initialized === 'true') return;

  root.dataset.initialized = 'true';

  const slides = [...root.querySelectorAll('[data-purelane-hero-slide]')];
  const dots = [...root.querySelectorAll('[data-purelane-hero-dot]')];

  if (!slides.length) return;

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  let current = 0;
  let timer = null;

  const show = (index) => {
    current = (index + slides.length) % slides.length;

    slides.forEach((slide, i) => {
      slide.classList.toggle('is-active', i === current);
    });

    dots.forEach((dot, i) => {
      const active = i === current;

      dot.classList.toggle('is-active', active);
      dot.setAttribute('aria-selected', active ? 'true' : 'false');
    });
  };

  const stop = () => {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
  };

  const play = () => {
    if (reduceMotion || timer || slides.length < 2) return;

    timer = setInterval(() => {
      show(current + 1);
    }, 3800);
  };

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      stop();
      show(Number(dot.dataset.index || 0));
      play();
    });
  });

  const stage = root.querySelector('[data-purelane-hero-stage]');

  if (stage) {
    stage.addEventListener('mouseenter', stop);
    stage.addEventListener('mouseleave', play);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              play();
            } else {
              stop();
            }
          });
        },
        { threshold: 0.2 }
      );

      observer.observe(stage);
    } else {
      play();
    }
  }

  show(0);
  play();
})();
</script>

{% schema %}
{
  "name": "Purelane hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Clean"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "That"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent heading",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Hero offer",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Offer label",
          "default": "Single bottle"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 3
        },
        {
          "type": "number",
          "id": "offer_price",
          "label": "Offer price",
          "default": 200
        },
        {
          "type": "number",
          "id": "compare_price",
          "label": "Compare-at price",
          "default": 299
        },
        {
          "type": "text",
          "id": "saving_text",
          "label": "Saving text",
          "default": "33% off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane hero",
      "blocks": [
        {
          "type": "offer",
          "settings": {
            "label": "Single bottle",
            "offer_price": 200,
            "compare_price": 299,
            "saving_text": "33% off"
          }
        },
        {
          "type": "offer",
          "settings": {
            "label": "Any 2 products",
            "offer_price": 349,
            "compare_price": 598,
            "saving_text": "Save ₹249"
          }
        },
        {
          "type": "offer",
          "settings": {
            "label": "Any 3 products",
            "offer_price": 499,
            "compare_price": 897,
            "saving_text": "Save ₹398"
          }
        }
      ]
    }
  ]
}
{% endschema %}