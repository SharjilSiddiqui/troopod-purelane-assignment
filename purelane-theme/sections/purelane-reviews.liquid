<section
  id="reviews"
  class="purelane-section pl-reviews"
>
  <div class="purelane-wrap">

    <div class="pl-reviews__head">
      <span class="pl-kicker">
        {{ section.settings.kicker | escape }}
      </span>

      <span class="pl-reviews__stat">
        <span class="pl-reviews__stars" aria-hidden="true">
          ★★★★★
        </span>

        <strong>{{ section.settings.rating }}</strong>
        {{ section.settings.review_summary | escape }}
      </span>

      {% if section.settings.homes_text != blank %}
        <span class="pl-reviews__stat">
          {{ section.settings.homes_text | escape }}
        </span>
      {% endif %}
    </div>

  </div>

  {% if section.blocks.size > 0 %}
    <div
      class="pl-reviews__rail"
      aria-label="Customer reviews"
    >
      <div class="pl-reviews__track">

        {% for copy in (1..2) %}
          {% for block in section.blocks %}
            <article
              class="pl-glass pl-review"
              {{ block.shopify_attributes }}
            >
              <div class="pl-review__stars" aria-label="5 out of 5 stars">
                ★★★★★
              </div>

              <h3 class="pl-review__title">
                {{ block.settings.title | escape }}
              </h3>

              <p class="pl-review__body">
                {{ block.settings.body }}
              </p>

              <div class="pl-review__author">
                {% render 'purelane-check-icon' %}
                <strong>{{ block.settings.author | escape }}</strong>

                {% if block.settings.product != blank %}
                  <span>
                    · {{ block.settings.product | escape }}
                  </span>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        {% endfor %}

      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_summary",
      "label": "Review summary",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes_text",
      "label": "Homes text",
      "default": "Loved by 12 lakh+ homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}