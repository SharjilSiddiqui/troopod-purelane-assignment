<section
  id="bundles"
  class="purelane-section pl-bundles"
>
  <div class="purelane-wrap">

    <div class="pl-glass pl-bundles__intro">
      <span class="pl-kicker">
        {{ section.settings.kicker | escape }}
      </span>

      <h2 class="pl-heading pl-heading--section">
        {{ section.settings.heading | escape }}
      </h2>

      {% if section.settings.description != blank %}
        <p class="pl-lede">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="pl-bundles__grid">
      {% for block in section.blocks %}
        <article
          class="pl-glass pl-bundle{% if block.settings.featured %} pl-bundle--featured{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.tag != blank %}
            <span class="pl-bundle__tag">
              {{ block.settings.tag | escape }}
            </span>
          {% endif %}

          <div class="pl-bundle__products">
            {% for product in block.settings.products limit: 5 %}
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 220
                  | image_tag:
                    class: 'pl-bundle__product-image',
                    loading: 'lazy',
                    widths: '100,150,180,220',
                    sizes: '60px',
                    alt: product.title
                }}
              {% endif %}
            {% endfor %}
          </div>

          <div class="pl-bundle__quantity">
            {{ block.settings.quantity }}
            <small>Products</small>
          </div>

          <div class="pl-bundle__price">
            {{ block.settings.bundle_price | money }}

            {% if block.settings.compare_price > block.settings.bundle_price %}
              <s>{{ block.settings.compare_price | money }}</s>
            {% endif %}
          </div>

          {% if block.settings.per_product_text != blank %}
            <p class="pl-bundle__per">
              {{ block.settings.per_product_text | escape }}
            </p>
          {% endif %}

          <ul class="pl-bundle__list">
            {% for i in (1..3) %}
              {% assign benefit_key = 'benefit_' | append: i %}
              {% assign benefit = block.settings[benefit_key] %}

              {% if benefit != blank %}
                <li>
                  {% render 'purelane-check-icon' %}
                  {{ benefit | escape }}
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          <a
            class="pl-button {% if block.settings.featured %}pl-button--primary{% else %}pl-button--ghost{% endif %}"
            href="{{ block.settings.button_link | default: '#shop' }}"
          >
            {{ block.settings.button_label | default: 'Build this box' | escape }}
          </a>
        </article>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 5
        },
        {
          "type": "number",
          "id": "quantity",
          "label": "Product count",
          "default": 2
        },
        {
          "type": "number",
          "id": "bundle_price",
          "label": "Bundle price",
          "default": 349
        },
        {
          "type": "number",
          "id": "compare_price",
          "label": "Compare-at price",
          "default": 598
        },
        {
          "type": "text",
          "id": "per_product_text",
          "label": "Per-product text",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "Benefit 1",
          "default": "Covers kitchen and laundry"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "Benefit 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "Benefit 3"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured bundle",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        {
          "type": "bundle",
          "settings": {
            "tag": "Starter",
            "quantity": 2,
            "bundle_price": 349,
            "compare_price": 598,
            "per_product_text": "Flat ₹174 per product"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "tag": "Most popular",
            "quantity": 3,
            "bundle_price": 499,
            "compare_price": 897,
            "per_product_text": "Flat ₹166 per product",
            "featured": true,
            "benefit_1": "Pick any three products",
            "benefit_2": "Covers kitchen and laundry",
            "benefit_3": "Free shipping across India"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "tag": "Whole home",
            "quantity": 5,
            "bundle_price": 799,
            "compare_price": 1495,
            "per_product_text": "Flat ₹160 per product",
            "benefit_1": "Pick any five products",
            "benefit_2": "Every room in one order",
            "benefit_3": "Free shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}